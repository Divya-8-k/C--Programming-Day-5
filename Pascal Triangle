#include <stdio.h>
int main()
{
    int rows = 5;
    int coef, i, j;
    for(i = 0; i < rows; i++)
    {
        for(j = 1; j <= rows - i; j++)
            printf("  ");
        coef = 1;
        for(j = 0; j <= i; j++)
        {
            printf("%4d", coef);
            coef = coef * (i - j) / (j + 1);
        }
        printf("\n");
    }
    return 0;
}

